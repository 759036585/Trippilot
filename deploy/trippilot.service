[Unit]
Description=TripPilot FastAPI backend
Documentation=https://github.com/759036585/Trippilot
After=network.target postgresql.service
Wants=postgresql.service
# 依赖安装期间可能短暂起不来，别急着判定失败（这两个键必须放在 [Unit] 里）
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# 换成服务器上实际运行服务的用户（要和 rsync 使用的部署用户一致，才能读到 .env.local）
User=trippilot
Group=trippilot
WorkingDirectory=/opt/trippilot/trippilot-backend

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8

# 只监听本机，由 nginx 对外提供服务
ExecStart=/opt/trippilot/trippilot-backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000

Restart=always
RestartSec=3

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
