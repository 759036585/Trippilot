# ===== 后端环境变量模板 =====
# 使用方法：复制本文件为 .env.local，然后填入真实值。
#   Windows PowerShell:  Copy-Item .env.example .env.local
#   macOS / Linux:       cp .env.example .env.local
#
# .env.local 不会被提交到 git（见仓库根目录 .gitignore），真实密钥只放在那里。
# 读取优先级：.env.local > .env

# PostgreSQL 连接串：postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+psycopg://postgres:你的密码@localhost:5432/trippilot_db

# 高德「Web服务」类型的 Key（不是前端用的 JS API Key）
AMAP_API_KEY=你的高德Web服务Key

# 大模型配置（以 DeepSeek 为例）
LLM_API_KEY=你的大模型APIKey
LLM_BASE_URL=https://api.deepseek.com

# 登录 token 的签名密钥，务必改成随机字符串，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=请填写随机字符串
